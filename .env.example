OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
TABLE_TRANSFORMER_MODEL=microsoft/table-transformer-detection
TABLE_DETECTION_CONFIDENCE_THRESHOLD=0.90
LOG_LEVEL=INFO
OUTPUT_DIRECTORY=output
OCR_CONTEXT_JSON=data/context.json
OCR_OUTPUT_JSON=output/context_result.json
OPENAI_CLASSIFICATION_MAX_RETRIES=3
OPENAI_CLASSIFICATION_RETRY_BACKOFF_SECONDS=1.0
OPENAI_INSIGHTS_MAX_RETRIES=3
OPENAI_INSIGHTS_RETRY_BACKOFF_SECONDS=1.0
